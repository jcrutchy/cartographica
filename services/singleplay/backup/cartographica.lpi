<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="cartographica"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
      <Icon Value="0"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="cartographica.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="umain.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FormMain"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="uMain"/>
      </Unit>
      <Unit>
        <Filename Value="net\uwebsocketserver.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uWebSocketServer"/>
      </Unit>
      <Unit>
        <Filename Value="game\utilemap.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uTileMap"/>
      </Unit>
      <Unit>
        <Filename Value="game\uisland.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uIsland"/>
      </Unit>
      <Unit>
        <Filename Value="game\uworld.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uWorld"/>
      </Unit>
      <Unit>
        <Filename Value="game\ugameserver.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uGameServer"/>
      </Unit>
      <Unit>
        <Filename Value="game\uplayer.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPlayer"/>
      </Unit>
      <Unit>
        <Filename Value="util\ulog.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uLog"/>
      </Unit>
      <Unit>
        <Filename Value="game\uconfig.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uConfig"/>
      </Unit>
      <Unit>
        <Filename Value="game\uprotocol.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uProtocol"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="cartographica"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="net;game;util"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
